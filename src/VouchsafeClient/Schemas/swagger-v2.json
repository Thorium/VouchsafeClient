{
  "openapi": "3.0.0",
  "components": {
    "examples": {},
    "headers": {},
    "parameters": {},
    "requestBodies": {},
    "responses": {},
    "schemas": {
      "PublicAddressV2": {
        "properties": {
          "residence_number": {
            "type": "string",
            "description": "The street number, with any flat or unit number in front, e.g. `\"10\"` or `\"Flat 2, 10\"`."
          },
          "building_name": {
            "type": "string",
            "description": "The name of the building, e.g. `\"Rose Cottage\"` or `\"Rose Court\"`."
          },
          "street": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "postcode": {
            "type": "string"
          },
          "country": {
            "type": "string"
          },
          "region": {
            "type": "string",
            "description": "State, province, or county."
          },
          "country_code": {
            "type": "string",
            "description": "ISO 3166-1 alpha-2 country code."
          }
        },
        "type": "object",
        "additionalProperties": false
      },
      "Recommendation": {
        "type": "string",
        "enum": [
          "REJECT",
          "REVIEW",
          "CLEAR"
        ]
      },
      "CheckState": {
        "type": "string",
        "enum": [
          "PASS",
          "FAIL",
          "INCONCLUSIVE",
          "PARTIAL",
          "NOT_PERFORMED"
        ]
      },
      "Reason": {
        "enum": [
          "INVALID_POSTCODE",
          "INVALID_ADDRESS",
          "MED_MATCH_PERSON_AT_ADDRESS",
          "LOW_MATCH_PERSON_AT_ADDRESS",
          "PARTIAL_ADDRESS_MATCH",
          "WEAK_IDENTITY_WITH_FULL_ADDRESS",
          "DOB_NOT_MATCHED",
          "DOB_FUZZY_MATCH",
          "NO_DOB_DATA",
          "NO_IDENTITY_MATCH",
          "NO_RESIDENCY_MATCH",
          "INVALID_PHONE_FORMAT"
        ],
        "type": "string"
      },
      "CheckResult": {
        "properties": {
          "state": {
            "$ref": "#/components/schemas/CheckState"
          },
          "reason": {
            "$ref": "#/components/schemas/Reason"
          }
        },
        "required": [
          "state"
        ],
        "type": "object",
        "additionalProperties": false
      },
      "Record_CreditBureauVerificationChecks.CheckResult_": {
        "properties": {
          "IDENTITY_MATCH": {
            "$ref": "#/components/schemas/CheckResult"
          },
          "RESIDENCY_MATCH": {
            "$ref": "#/components/schemas/CheckResult"
          }
        },
        "required": [
          "IDENTITY_MATCH",
          "RESIDENCY_MATCH"
        ],
        "type": "object",
        "description": "Construct a type with a set of properties K of type T"
      },
      "CreditBureauVerificationReport": {
        "properties": {
          "state": {
            "$ref": "#/components/schemas/CheckState"
          },
          "checks": {
            "$ref": "#/components/schemas/Record_CreditBureauVerificationChecks.CheckResult_"
          }
        },
        "required": [
          "state",
          "checks"
        ],
        "type": "object",
        "additionalProperties": false
      },
      "OnlineFootprintChecks": {
        "anyOf": [
          {
            "properties": {
              "PHONE_SCORE": {
                "$ref": "#/components/schemas/CheckResult"
              },
              "EMAIL_SCORE": {
                "$ref": "#/components/schemas/CheckResult"
              }
            },
            "required": [
              "EMAIL_SCORE"
            ],
            "type": "object"
          },
          {
            "properties": {
              "EMAIL_SCORE": {
                "$ref": "#/components/schemas/CheckResult"
              },
              "PHONE_SCORE": {
                "$ref": "#/components/schemas/CheckResult"
              }
            },
            "required": [
              "PHONE_SCORE"
            ],
            "type": "object"
          }
        ]
      },
      "OnlineFootprintVerificationReport": {
        "properties": {
          "state": {
            "$ref": "#/components/schemas/CheckState"
          },
          "checks": {
            "$ref": "#/components/schemas/OnlineFootprintChecks"
          }
        },
        "required": [
          "state",
          "checks"
        ],
        "type": "object",
        "additionalProperties": false
      },
      "Record_AmlVerificationChecks.CheckResult_": {
        "properties": {
          "AML_SANCTIONS_CHECK": {
            "$ref": "#/components/schemas/CheckResult"
          }
        },
        "required": [
          "AML_SANCTIONS_CHECK"
        ],
        "type": "object",
        "description": "Construct a type with a set of properties K of type T"
      },
      "AmlVerificationReport": {
        "properties": {
          "state": {
            "$ref": "#/components/schemas/CheckState"
          },
          "checks": {
            "$ref": "#/components/schemas/Record_AmlVerificationChecks.CheckResult_"
          }
        },
        "required": [
          "state",
          "checks"
        ],
        "type": "object",
        "additionalProperties": false
      },
      "AdverseMediaOutcome": {
        "type": "string",
        "enum": [
          "PASS",
          "REVIEW",
          "FAIL"
        ]
      },
      "AdverseMediaRiskArticle": {
        "properties": {
          "title": {
            "type": "string",
            "description": "Headline of the news article"
          },
          "link": {
            "type": "string",
            "description": "URL to the original article"
          },
          "source": {
            "type": "string",
            "description": "Name of the publication"
          },
          "published_at": {
            "type": "string",
            "nullable": true,
            "description": "Publication date as an ISO 8601 timestamp, or null if the date could not be determined"
          },
          "snippet": {
            "type": "string",
            "description": "Short excerpt from the article"
          },
          "level": {
            "$ref": "#/components/schemas/AdverseMediaOutcome",
            "description": "`FAIL` when the article accuses the person of wrongdoing that signals fraud, `REVIEW` when a person needs to check it, otherwise `PASS`"
          },
          "reason": {
            "type": "string",
            "description": "Why the article was given its level"
          }
        },
        "required": [
          "title",
          "link",
          "source",
          "published_at",
          "snippet",
          "level",
          "reason"
        ],
        "type": "object",
        "additionalProperties": false
      },
      "AdverseMediaRiskReport": {
        "properties": {
          "state": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AdverseMediaOutcome"
              },
              {
                "type": "string",
                "enum": [
                  "NOT_PERFORMED"
                ]
              }
            ],
            "description": "The screening outcome, or `NOT_PERFORMED` when the search couldn't run"
          },
          "articles": {
            "items": {
              "$ref": "#/components/schemas/AdverseMediaRiskArticle"
            },
            "type": "array",
            "description": "Every article the search found"
          }
        },
        "required": [
          "state",
          "articles"
        ],
        "type": "object",
        "additionalProperties": false
      },
      "EnrichmentReports": {
        "properties": {
          "credit_bureau": {
            "$ref": "#/components/schemas/CreditBureauVerificationReport",
            "description": "Credit bureau check report. Present when `\"CREDIT_BUREAU\"` was requested."
          },
          "online_footprint": {
            "$ref": "#/components/schemas/OnlineFootprintVerificationReport",
            "description": "Online footprint check report. Present when `\"ONLINE_FOOTPRINT\"` was requested."
          },
          "aml": {
            "$ref": "#/components/schemas/AmlVerificationReport",
            "description": "AML / sanctions check report. Present when `\"AML\"` was requested."
          },
          "adverse_media": {
            "$ref": "#/components/schemas/AdverseMediaRiskReport",
            "description": "Adverse media report. Present when `\"ADVERSE_MEDIA\"` was requested.\n\nLists every article the search found. An article is `FAIL` when it accuses the person of wrongdoing that signals fraud, such as fraud, financial crime or a regulatory ban, `REVIEW` when a person needs to check it, and otherwise `PASS`. An article needs checking when it might be about someone else with the same name, the person was acquitted, or the wrongdoing is not a sign of fraud, such as violence.\n\n`state` is `FAIL` when any article is `FAIL`, `REVIEW` when any needs review, and `NOT_PERFORMED` when the search couldn't run. Adding `address.city` narrows the search."
          }
        },
        "type": "object",
        "additionalProperties": false
      },
      "RiskMetadata": {
        "properties": {
          "thresholds": {
            "properties": {
              "aml": {
                "type": "number",
                "format": "double",
                "description": "AML pass/fail threshold (0–100). Default: 96."
              },
              "online_footprint": {
                "type": "number",
                "format": "double",
                "description": "Online footprint pass/fail threshold (0–100). Default: 50."
              }
            },
            "required": [
              "aml",
              "online_footprint"
            ],
            "type": "object",
            "description": "Effective score thresholds used for the optional enrichment checks."
          }
        },
        "type": "object",
        "additionalProperties": false
      },
      "GetRiskResponse": {
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier for this risk assessment."
          },
          "team_id": {
            "type": "string",
            "description": "The team that performed this assessment."
          },
          "enrichments": {
            "items": {
              "type": "string",
              "enum": [
                "CREDIT_BUREAU",
                "ONLINE_FOOTPRINT",
                "AML",
                "ADVERSE_MEDIA"
              ]
            },
            "type": "array",
            "description": "The optional enrichment checks that were requested alongside Radar."
          },
          "first_name": {
            "type": "string"
          },
          "last_name": {
            "type": "string"
          },
          "address": {
            "allOf": [
              {
                "$ref": "#/components/schemas/PublicAddressV2"
              }
            ],
            "nullable": true,
            "description": "The address that was submitted, or null if none was provided."
          },
          "date_of_birth": {
            "type": "string",
            "description": "Date of birth in YYYY-MM-DD format."
          },
          "email": {
            "type": "string",
            "description": "Email address used as the primary Radar matching key."
          },
          "phone": {
            "type": "string"
          },
          "risk_score": {
            "type": "number",
            "format": "double",
            "description": "Risk score from 0 (highest risk) to 100 (lowest risk).\nDerived from the weighted sum of trust and fraud signals detected.",
            "example": 72
          },
          "recommendation": {
            "$ref": "#/components/schemas/Recommendation",
            "description": "Recommended action based on `risk_score`.\n\n- `\"CLEAR\"` — score 60–100: low risk, proceed with confidence\n- `\"REVIEW\"` — score 34–59: elevated risk, consider further checks\n- `\"REJECT\"` — score 0–33: high risk, the identity is likely fraudulent"
          },
          "trust_signals": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "description": "Signals that contributed positively to the risk score."
          },
          "fraud_signals": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "description": "Signals that contributed negatively to the risk score."
          },
          "enrichment_reports": {
            "$ref": "#/components/schemas/EnrichmentReports",
            "description": "Enrichment check reports, keyed by enrichment name. Present when enrichments were requested."
          },
          "metadata": {
            "$ref": "#/components/schemas/RiskMetadata",
            "description": "Supplementary data: effective thresholds used for the optional enrichment checks."
          },
          "billable": {
            "type": "boolean",
            "description": "Whether the check consumed billable credits."
          },
          "alerts_enabled_at": {
            "type": "string",
            "nullable": true,
            "description": "When ongoing AML monitoring was enabled (ISO 8601), or `null` if not active. See [Alerts API](https://docs.vouchsafe.id/api/v1/toggle-alerts)."
          },
          "created_at": {
            "type": "string",
            "description": "ISO 8601 timestamp of when this risk assessment was created."
          }
        },
        "required": [
          "id",
          "team_id",
          "enrichments",
          "first_name",
          "last_name",
          "address",
          "date_of_birth",
          "email",
          "risk_score",
          "recommendation",
          "trust_signals",
          "fraud_signals",
          "billable",
          "alerts_enabled_at",
          "created_at"
        ],
        "type": "object",
        "additionalProperties": false
      },
